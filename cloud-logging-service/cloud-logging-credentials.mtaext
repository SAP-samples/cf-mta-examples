_schema-version: 3.3.0
ID: cloud.logging.export.credentials
extends: cloud.logging.export.example
version: 1.0.0

# Keep the environment-specific values (the concrete SAP Cloud Logging instance,
# its service key, and - if relevant - the org/space where the instance resides)
# in an extension descriptor, external to the packaged MTA archive (*.mtar).

resources:
  - name: my-cloud-logging
    parameters:
      service-name: my-cloud-logging-instance
      service-key-name: my-service-key
      log-level: INFO
      destination:
        org-name: my-org
        space-name: my-space
